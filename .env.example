# 1. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. (Optional) Which Gemini model(s) to use.
#    GEMINI_MODELS accepts a comma-separated list and will populate the UI dropdown.
#    GEMINI_MODEL remains the default single model if set.
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODELS=gemini-flash-latest,gemini-3.6-flash, gemini-2.5-flash,gemini-3.1-pro-preview

# 3. (Optional) Use an existing wallet for the agent (private key, 0x...).
#    Leave empty and use the "Create wallet" button on the page instead.
#    Use a TEST wallet only. Never put a wallet with real money here.
#    AGENT_PRIVATE_KEY is preferred for the vault-enabled agent; WALLET_PRIVATE_KEY
#    remains supported for compatibility with the original demo.
AGENT_PRIVATE_KEY=
WALLET_PRIVATE_KEY=

# 4. Base Sepolia vault access (server-side; never put an owner key here).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
VAULT_ADDRESS=
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
AGENT_ALLOWED_RECIPIENTS=
# Set true only for a testnet red-team demo where a reverted transaction should be sent on-chain.
DEMO_FORCE_SEND=false

# 5. Demo x402 guardrails (off-chain): these are not a smart contract.
X402_MAX_PER_CALL=0.05
X402_DAILY_BUDGET=0.50
X402_ALLOWED_PAYEES=

# 6. Optional countries API key for /api/countries
COUNTRIES_API_KEY=